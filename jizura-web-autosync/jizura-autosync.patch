+  src.buffer = buf; src.connect(oc.destination); src.start();
+  const r = await oc.startRendering();
+  return new Float32Array(r.getChannelData(0));
+}
+
+/* ---------------- UI: two buttons in 曲とタイミング ---------------- */
+let busy = false;
+function status(text) { const el = $('jzAutoStatus'); el.hidden = !text; el.textContent = text || ''; }
+async function runSync() {
+  const S = J.ui, api = J.uiApi, c = L();
+  if (busy) return;
+  if (!S.audio || !S.audio.buffer) { api.toast(c.noAudio); return; }
+  const lines = S.plan.lines.filter(l => l.index >= 0);
+  if (!lines.some(l => !l.interlude && l.text)) { api.toast(c.noLyrics); return; }
+  busy = true; $('jzAutoSync').disabled = true;
+  const files = {}; let timer = null;
+  try {
+    status(c.prep); api.pause();
+    const audio = await to16k(S.audio.buffer);
+    const lang = J.autoGuessLang(lines.map(l => l.text).join('\n')), t0 = Date.now();
+    const chunks = await recognise(audio, lang, $('jzAutoModel').value, m => {
+      if (m.type === 'load') { files[m.file] = [m.loaded, m.total]; const v = Object.values(files); status(c.load(Math.round(100 * v.reduce((a, x) => a + x[0], 0) / v.reduce((a, x) => a + x[1], 0)))); }
+      if (m.type === 'run') { const r0 = Date.now(); status(c.run(0)); timer = setInterval(() => status(c.run(Math.round((Date.now() - r0) / 1000))), 1000); }
+    });
+    const byIndex = []; lines.forEach(l => { byIndex[l.index] = l; });
+    const R = J.autoTimes(chunks, byIndex.map(l => l || { interlude: true, text: '' }));
+    const T = S.project.timing; T.lineTimes = T.lineTimes || {}; T.auto = {};
+    let n = 0;
+    for (const [li, a] of Object.entries(R.lines)) {
+      T.lineTimes[li] = a.s;
+      if (!a.interlude) { T.auto[li] = a; n++; }
+    }
+    api.replan(); api.flushSave();
+    const rate = Math.round(R.rate * 100);
+    status(c.done(n, rate) + (rate < 55 ? ' — ' + c.low : ''));
+    console.log('[JIZURA auto sync]', lang, ((Date.now() - t0) / 1000).toFixed(1) + 's', chunks.length + ' words', rate + '%');
+  } catch (e) {
+    status(c.fail(e.message)); console.error(e);
+  } finally { clearInterval(timer); busy = false; $('jzAutoSync').disabled = false; }
+}
+
+/* ---------------- one-click After Effects script ---------------- */
+const esc = s => s.replace(/[\u0080-￿]/g, ch => '\\u' + ch.charCodeAt(0).toString(16).toUpperCase().padStart(4, '0'));
+async function panelSource() {
+  const file = document.documentElement.lang === 'ja' ? 'JIZURA_AE.jsx' : 'JIZURA_AE_en.jsx';
+  const here = document.documentElement.lang === 'ja' ? './' : '../';
+  for (const url of [here + file, 'https://raw.githubusercontent.com/852wa/JIZURA/main/' + file]) {
+    try { const r = await fetch(url, { cache: 'no-cache' }); if (r.ok) { const s = await r.text(); if (s.includes('\njzUI(thisObj);')) return s; } } catch (e) {}
+  }
