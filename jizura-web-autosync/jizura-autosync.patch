+    if (JZLOG.length) msg += '\\n\\n' + JZLOG.slice(0, 10).join('\\n');
+    alert(msg);
+})();
+`;
+J.aeScript = (panel, plan, audioName) => panel.replace('\njzUI(thisObj);', '\n' + DRIVER.replace('@PLAN@', () => esc(JSON.stringify(plan))).replace('@AUDIO@', () => esc(JSON.stringify(audioName || ''))));
+async function exportJsx() {
+  const S = J.ui, api = J.uiApi, c = L();
+  if (busy) return;
+  busy = true; status(c.jsxGet);
+  try {
