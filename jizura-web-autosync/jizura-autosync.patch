+if (!document.getElementById('app')) return;          // engine-only pages (tests)
+const $ = id => document.getElementById(id);
+const TF_URL = 'https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.5.1';
+const MODELS = [['onnx-community/whisper-base_timestamped', 'Whisper base'], ['onnx-community/whisper-small_timestamped', 'Whisper small']];
+const COPY = {
