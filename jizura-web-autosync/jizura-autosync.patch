+    }
+    if (!app.project) app.newProject();
+    app.beginUndoGroup('JIZURA');
+    try { if (f) item = app.project.importFile(new ImportOptions(f)); } catch (e1) { alert('JIZURA: ' + e1.toString()); }
+    app.endUndoGroup();
+    var w = null, bar = null, job = null;
+    try { w = new Window('palette', 'JIZURA'); bar = w.add('progressbar', undefined, 0, JA_PLAN.cuts.length || 1); bar.preferredSize.width = 320; w.show(); } catch (e2) { w = null; }
+    app.beginUndoGroup('JIZURA build');
+    try {
+        job = jzBuildStart(JA_PLAN, { roles: JZ_ROLE_DEFAULT, audioItem: item, audioStart: -(+JA_PLAN.audioOffset || 0), light: false });
+        while (!job.finished) { job.step(700); if (bar) { bar.value = job.done || 0; try { w.update(); } catch (e3) {} } }
+    } catch (e4) { alert('JIZURA: ' + e4.toString() + (e4.line ? ' (line ' + e4.line + ')' : '')); }
