+const DRIVER = `
+// ---- one-click build (JIZURA web: AE script): the panel's engine builds the plan below, no panel window
+var JA_PLAN = @PLAN@, JA_AUDIO = @AUDIO@;
+(function () {
+    var f = null, item = null, here = null;
+    if (JA_AUDIO) {
+        try { here = File($.fileName).parent; } catch (e0) {}
