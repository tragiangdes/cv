+    done: (n, r) => `${n}行を同期しました（文字の一致 ${r}%）。ずれた行はタップ・ドラッグで直せます。「手動タイミングを消す」で元に戻ります`,
+    low: '一致率が低いため、歌詞と曲が合っているか確認してください', fail: m => '自動同期できませんでした: ' + m,
+    jsxGet: 'AE パネルのエンジンを取得中…', jsxDone: n => `${n} を保存しました。After Effects の「ファイル › スクリプト › スクリプトファイルを実行」で開き、曲ファイルを同じフォルダに置いてください`,
+    jsxFail: 'AE パネル（JIZURA_AE.jsx）を取得できませんでした。JIZURA_AE.jsx を選んでください', tipSync: '曲を聴き取り、各行・各カットの開始を歌声に合わせます（ブラウザ内で処理・曲は送信しません）',
+    tipJsx: 'AE パネルなしで実行できる 1 ファイルのスクリプト。曲を読み込み、このプランのコンポを作ります' },
+  en: { sync: 'Auto-sync lyrics', jsx: 'AE script (.jsx)', model: 'Speech model', noAudio: 'Load a song first', noLyrics: 'No lyrics',
+    load: p => `Loading the model… ${p}% (first time only, then cached in this browser)`, prep: 'Preparing audio…', run: s => `Listening for the lyrics… ${s}s`,
+    done: (n, r) => `Synced ${n} lines (characters matched: ${r}%). Fix any line by tapping or dragging; "Clear manual timing" undoes it`,
+    low: 'Low match rate: check that the lyrics belong to this song', fail: m => 'Auto-sync failed: ' + m,
+    jsxGet: 'Fetching the AE panel engine…', jsxDone: n => `Saved ${n}. In After Effects: File › Scripts › Run Script File…, with the song in the same folder`,
+    jsxFail: 'Could not fetch the AE panel (JIZURA_AE_en.jsx). Please choose the file', tipSync: 'Listens to the song and puts every line and cut start on the vocals (runs in this browser; the song is not uploaded)',
+    tipJsx: 'A single script that runs without the AE panel: imports the song and builds this plan as a comp' },
+  vi: { sync: 'Tự căn lời (AI)', jsx: 'Xuất script AE (.jsx)', model: 'Model nhận dạng', noAudio: 'Hãy chọn tệp nhạc trước', noLyrics: 'Chưa có lời bài hát',
+    load: p => `Đang tải model… ${p}% (chỉ lần đầu, sau đó lưu trong trình duyệt)`, prep: 'Đang chuẩn bị âm thanh…', run: s => `Đang nghe và căn lời… ${s} giây`,
+    done: (n, r) => `Đã căn ${n} câu (khớp ${r}% ký tự). Câu nào lệch có thể bấm nhịp hoặc kéo lại; "Xóa thời gian thủ công" để hoàn tác`,
+    low: 'Tỉ lệ khớp thấp — kiểm tra lời có đúng bài hát này không', fail: m => 'Không tự căn được: ' + m,
+    jsxGet: 'Đang lấy engine của panel AE…', jsxDone: n => `Đã lưu ${n}. Trong After Effects: File › Scripts › Run Script File…, đặt file nhạc cùng thư mục`,
+    jsxFail: 'Không tải được panel AE (JIZURA_AE_en.jsx). Hãy chọn file đó', tipSync: 'Nghe bài hát và đặt điểm bắt đầu của từng câu, từng cảnh đúng vào giọng hát (xử lý trong trình duyệt, không tải nhạc lên mạng)',
+    tipJsx: 'Một file script chạy được không cần panel AE: tự import nhạc và dựng comp theo bố cục hiện tại' },
+};
+const L = () => COPY[document.documentElement.lang] || COPY.en;
+
+/* ---------------- lyric characters <-> recognised words ---------------- */
+const charsOf = t => [...String(t).replace(/\s+/g, '')];
+J.autoGuessLang = text => /[぀-ヿ]/.test(text) ? 'japanese' : /[가-힯]/.test(text) ? 'korean' : /[一-鿿]/.test(text) ? 'chinese'
+  : /[ăâđêôơưạảấầẩẫậắằẳẵặẹẻẽếềểễệỉịọỏốồổỗộớờởỡợụủứừửữựỳỵỷỹ]/i.test(text) ? 'vietnamese' : 'english';
+
+// global alignment (match +2, mismatch / gap −1): index into A for every character of B, or −1
+function alignChars(A, B) {
+  const n = A.length, m = B.length, W = m + 1, dir = new Uint8Array((n + 1) * W);
+  let prev = new Int32Array(W), cur = new Int32Array(W);
+  for (let j = 1; j <= m; j++) { prev[j] = -j; dir[j] = 2; }
+  for (let i = 1; i <= n; i++) {
+    cur[0] = -i; dir[i * W] = 1;
+    for (let j = 1; j <= m; j++) {
+      const d = prev[j - 1] + (A[i - 1] === B[j - 1] ? 2 : -1), u = prev[j] - 1, l = cur[j - 1] - 1;
+      if (d >= u && d >= l) { cur[j] = d; dir[i * W + j] = 0; } else if (u >= l) { cur[j] = u; dir[i * W + j] = 1; } else { cur[j] = l; dir[i * W + j] = 2; }
+    }
+    [prev, cur] = [cur, prev];
+  }
+  const map = new Int32Array(m).fill(-1), same = new Uint8Array(m);
+  let i = n, j = m;
+  while (i > 0 && j > 0) {
+    const d = dir[i * W + j];
+    if (d === 0) { map[j - 1] = i - 1; same[j - 1] = A[i - 1] === B[j - 1] ? 1 : 0; i--; j--; } else if (d === 1) i--; else j--;
+  }
+  return { map, same };
+}
+
+// recognised chunks [{text, timestamp:[s, e]}] + plan lines -> per line { s, e, c[], t }, and the share of matched characters
+J.autoTimes = (chunks, lines, lead = 0.12) => {
+  const A = [], At = [];
+  for (const ch of chunks) {
+    const cs = charsOf(ch.text || ''); if (!cs.length || !ch.timestamp) continue;
+    const s = +ch.timestamp[0], e = Math.max(ch.timestamp[1] != null ? +ch.timestamp[1] : s + 0.3, s + 0.01);
+    if (!isFinite(s)) continue;
+    cs.forEach((c, k) => { A.push(c.toLowerCase()); At.push([s + (e - s) * k / cs.length, s + (e - s) * (k + 1) / cs.length]); });
+  }
+  const B = [], owner = [];
+  lines.forEach((ln, li) => { if (!ln.interlude) for (const c of charsOf(ln.text)) { B.push(c.toLowerCase()); owner.push(li); } });
+  if (!A.length || !B.length) throw new Error('no speech recognised');
+  const { map, same } = alignChars(A, B), T = new Array(B.length).fill(null);
+  let hits = 0;
+  for (let b = 0; b < B.length; b++) if (map[b] >= 0) { T[b] = At[map[b]]; hits += same[b]; }
+  fillGaps(T, owner);
+  const per = lines.map(() => []);
+  owner.forEach((li, b) => per[li].push(T[b]));
+  const out = {}; let prevEnd = 0;
+  lines.forEach((ln, li) => {
+    if (ln.interlude) { out[li] = { interlude: true, s: prevEnd + 0.3 }; return; }
+    const ts = per[li]; if (!ts.length) return;
+    let c = ts.map(t => Math.max(0, +(t[0] - lead).toFixed(3)));
+    for (let k = 1; k < c.length; k++) c[k] = Math.max(c[k], c[k - 1]);
+    const s = Math.max(c[0], prevEnd - lead);
+    c = c.map(x => Math.max(x, s));
+    const e = +Math.max(ts[ts.length - 1][1], s + 0.3).toFixed(3);
+    out[li] = { t: ln.text, s: +s.toFixed(3), e, c };
+    prevEnd = e;
+  });
+  return { lines: out, rate: hits / B.length };
+};
+// characters the recogniser missed: interpolate inside a line; across a line break continue / lead in at ~step s per character
+function fillGaps(T, owner, step = 0.15) {
+  const known = []; T.forEach((t, i) => { if (t) known.push(i); });
+  if (!known.length) throw new Error('no lyric matched the song');
+  let ka = -1;
+  for (let i = 0; i < T.length; i++) {
+    if (T[i]) { ka = i; continue; }
+    let kb = i + 1; while (kb < T.length && !T[kb]) kb++;
+    const a = ka >= 0 ? ka : null, b = kb < T.length ? kb : null;
+    let t;
+    if (a != null && b != null && owner[a] === owner[i] && owner[b] === owner[i]) t = T[a][1] + (T[b][0] - T[a][1]) * (i - a) / (b - a);
+    else if (a != null && owner[a] === owner[i]) { t = T[a][1] + step * (i - a - 1); if (b != null) t = Math.min(t, T[b][0] - step * (b - i)); }
+    else if (b != null) { t = T[b][0] - step * (b - i); if (a != null) t = Math.max(t, T[a][1]); }
+    else t = T[a][1] + step * (i - a);
+    t = Math.max(0, t); T[i] = [t, t + step * 0.8];
+  }
+}
+
+/* ---------------- speech recognition in a module worker ---------------- */
+const WORKER = `import { pipeline, env } from '${TF_URL}';
+env.allowLocalModels = false;
+let asr = null, key = '';
+async function load(model, device) {
+  return pipeline('automatic-speech-recognition', model, { device, dtype: device === 'webgpu' ? { encoder_model: 'fp32', decoder_model_merged: 'q4' } : undefined,
+    progress_callback: p => { if (p.status === 'progress' && p.total) self.postMessage({ type: 'load', file: p.file, loaded: p.loaded, total: p.total }); } });
+}
+self.onmessage = async ({ data }) => {
+  try {
+    if (!asr || key !== data.model) {
+      key = data.model;
+      try { asr = await load(data.model, data.webgpu ? 'webgpu' : 'wasm'); } catch (e) { if (!data.webgpu) throw e; asr = await load(data.model, 'wasm'); }
+    }
+    self.postMessage({ type: 'run' });
+    const o = { language: data.lang, task: 'transcribe', chunk_length_s: 30, stride_length_s: 5 };
+    let out;
+    try { out = await asr(data.audio, Object.assign({ return_timestamps: 'word' }, o)); }
+    catch (e) { out = await asr(data.audio, Object.assign({ return_timestamps: true }, o)); }     // models without word timing: phrase level
+    self.postMessage({ type: 'done', chunks: out.chunks || [] });
+  } catch (e) { self.postMessage({ type: 'error', message: String((e && e.message) || e) }); }
+};`;
+let worker = null;
+function recognise(audio, lang, model, onMsg) {
+  if (!worker) worker = new Worker(URL.createObjectURL(new Blob([WORKER], { type: 'text/javascript' })), { type: 'module' });
+  return new Promise((resolve, reject) => {
+    worker.onmessage = ({ data }) => { if (data.type === 'done') resolve(data.chunks); else if (data.type === 'error') reject(new Error(data.message)); else onMsg(data); };
+    worker.onerror = e => { worker = null; reject(new Error(e.message || 'worker error')); };
+    worker.postMessage({ audio, lang, model, webgpu: !!navigator.gpu }, [audio.buffer]);
